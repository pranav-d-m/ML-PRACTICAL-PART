import pandas as pd
import numpy as np
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

# Synthetic Data Example (Annual Income vs Spending Score)
np.random.seed(42)
n = 300
data = pd.DataFrame({
    'Annual_Income_k$': np.random.randint(15, 140, n),
    'Spending_Score': np.random.randint(1, 100, n)
})

# Feature Scaling is critical for distance-based clustering
scaler = StandardScaler()
scaled_data = scaler.fit_transform(data)

# Apply K-Means to find 4 customer clusters
kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)
data['Cluster'] = kmeans.fit_predict(scaled_data)

# View first few segmented customers
print(data.head())
print("\nCluster Center Coordinates (Scaled):\n", kmeans.cluster_centers_)
